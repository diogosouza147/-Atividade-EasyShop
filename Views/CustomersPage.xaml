<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:EasyShop.Models"
             x:Class="EasyShop.Views.CustomersPage"
             Title="Clientes (SQL)">

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12">

        <VerticalStackLayout Grid.Row="0" Spacing="8">
            <Label Text="Novo cliente" FontSize="18" FontAttributes="Bold" />
            <Entry Placeholder="Nome completo" Text="{Binding Name}" />
            <Entry Placeholder="E-mail" Keyboard="Email" Text="{Binding Email}" />
            <Button Text="Salvar cliente" Command="{Binding SaveCommand}" />
            <Label Text="{Binding Message}" FontSize="13">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding IsError}" Value="True">
                        <Setter Property="TextColor" Value="Red" />
                    </DataTrigger>
                    <DataTrigger TargetType="Label" Binding="{Binding IsError}" Value="False">
                        <Setter Property="TextColor" Value="Green" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Customers}">
            <CollectionView.EmptyView>
                <Label Text="Nenhum cliente cadastrado." HorizontalOptions="Center" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Customer">
                    <Border Padding="12" Margin="0,4" StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" />
                            <Label Text="{Binding Email}" FontSize="13" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
