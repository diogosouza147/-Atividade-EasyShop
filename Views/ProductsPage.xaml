<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:EasyShop.Models"
             x:Class="EasyShop.Views.ProductsPage"
             Title="Produtos (NoSQL)">

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12">

        <VerticalStackLayout Grid.Row="0" Spacing="8">
            <Label Text="Novo produto" FontSize="18" FontAttributes="Bold" />
            <Entry Placeholder="Nome" Text="{Binding Name}" />
            <Entry Placeholder="Preço (ex.: 59,90)" Keyboard="Numeric" Text="{Binding Price}" />
            <Entry Placeholder="Categoria (opcional)" Text="{Binding Category}" />
            <Editor Placeholder="Atributos opcionais: Cor=Azul; Tamanho=M; Garantia=12 meses"
                    HeightRequest="80" AutoSize="TextChanges" Text="{Binding Attributes}" />
            <Button Text="Salvar produto" Command="{Binding SaveCommand}" />
            <Label Text="{Binding Message}" FontSize="13">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding IsError}" Value="True">
                        <Setter Property="TextColor" Value="Red" />
                    </DataTrigger>
                    <DataTrigger TargetType="Label" Binding="{Binding IsError}" Value="False">
                        <Setter Property="TextColor" Value="Green" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Products}">
            <CollectionView.EmptyView>
                <Label Text="Nenhum produto cadastrado." HorizontalOptions="Center" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Product">
                    <Border Padding="12" Margin="0,4" StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" />
                            <Label Text="{Binding PriceText}" />
                            <Label Text="{Binding CategoryText}" FontSize="12" />
                            <Label Text="{Binding AttributesText}" FontSize="12" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
